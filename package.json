{
  "name": "baoleme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma db push",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "verify:unit": "node scripts/verify.mjs unit",
    "verify:e2e": "node scripts/verify.mjs e2e",
    "verify:all": "node scripts/verify.mjs all",
    "verify:ai": "tsx scripts/verify-ai.ts",
    "verify:ai:e2e": "tsx scripts/verify-ai-e2e.ts",
    "worker:ai": "tsx scripts/ai-worker.ts",
    "worker:content": "tsx scripts/content-worker.ts",
    "verify:content-sources": "vitest run tests/content-sources.test.ts",
    "preflight:prod": "tsx scripts/preflight-prod.ts",
    "trial:check": "tsx scripts/trial-check.ts",
    "trial:start": "tsx scripts/trial-start.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "next": "16.2.6",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rss-parser": "^3.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10",
    "prettier": "^3",
    "tailwindcss": "^4",
    "tsx": "^4.22.1",
    "typescript": "^5",
    "vitest": "^3"
  }
}
