# ═══════════════════════════════════════════════════════════════
# 爆了么 — 生产/试用环境变量
# 复制为 .env 后修改真实值
# ═══════════════════════════════════════════════════════════════

# ── 数据库 ───────────────────────────────────────────────────
# 生产必须使用独立 PostgreSQL，不得使用 Prisma dev（本地捆绑 PG）。
# 建议使用 Supabase / Railway / Neon / RDS / Docker Postgres。
DATABASE_URL="postgres://user:password@host:5432/baoleme?sslmode=disable"

# ── JWT 签名密钥 ─────────────────────────────────────────────
# 生产必须更换为强随机字符串（至少 32 位）。
# 生成方式: openssl rand -hex 32
JWT_SECRET="change-me-in-production-MUST-use-strong-random-string"

# ── 应用 URL ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ── AI Provider ──────────────────────────────────────────────
AI_PROVIDER="openai-compatible"
AI_BASE_URL="https://api.deepseek.com/v1"
AI_API_KEY="sk-your-deepseek-key"
AI_MODEL="deepseek-chat"
AI_TIMEOUT_MS="30000"

# ── AI Worker ────────────────────────────────────────────────
# Worker poll interval (ms) — 生产可适当放宽到 3000-5000
AI_WORKER_POLL_MS="2000"
# Stale running job timeout (ms) — 生产可改为 900000 (15 分钟)
AI_WORKER_STALE_MS="600000"
