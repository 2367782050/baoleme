# Database — PostgreSQL connection string
# Recommended: Docker Postgres (see docker-compose.yml)
#   docker compose up -d
DATABASE_URL="postgres://baoleme:baoleme_dev@localhost:15432/baoleme?sslmode=disable"

# Alternative: Prisma dev (local bundled PostgreSQL — port changes on restart)
#   npx prisma dev --name baoleme
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/baoleme?sslmode=disable"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT Secret (change in production)
JWT_SECRET="change-me-in-production"

# AI Provider
# Options: "mock" (default for development), or "openai-compatible" for real API
AI_PROVIDER="mock"
# AI_BASE_URL="https://api.openai.com/v1"
# AI_API_KEY="sk-..."
# AI_MODEL="gpt-4o"
# AI_TIMEOUT_MS="120000"
