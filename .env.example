# Database — PostgreSQL connection string
# Recommended: Docker Postgres (see docker-compose.yml)
#   docker compose up -d
DATABASE_URL="postgres://baoleme:baoleme_dev@localhost:15432/baoleme?sslmode=disable"

# Alternative: Prisma dev (local bundled PostgreSQL — port changes on restart)
#   npx prisma dev --name baoleme
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/baoleme?sslmode=disable"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT Secret (change in production)
JWT_SECRET="change-me-in-production"

# AI Provider
# Options: "mock" (default for development), or "openai-compatible" for real API
AI_PROVIDER="mock"
# AI_BASE_URL="https://api.openai.com/v1"
# AI_API_KEY="sk-..."
# AI_MODEL="gpt-4o"
# AI_TIMEOUT_MS="120000"

# ── Real AI configuration examples ────────────────────────────

# DeepSeek:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=sk-your-deepseek-key
# AI_MODEL=deepseek-chat
# AI_TIMEOUT_MS=30000

# OpenAI:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-your-openai-key
# AI_MODEL=gpt-4o
# AI_TIMEOUT_MS=30000

# SiliconFlow (硅基流动):
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.siliconflow.cn/v1
# AI_API_KEY=sk-your-siliconflow-key
# AI_MODEL=deepseek-ai/DeepSeek-V3
# AI_TIMEOUT_MS=30000

# Real AI acceptance test: npm run verify:ai

# ── Content Sources ───────────────────────────────────────────

# Comma-separated list of enabled content sources: rss, newrank
CONTENT_SOURCES="rss"

# Content worker polling interval in ms (default: 900000 = 15 min)
CONTENT_WORKER_POLL_MS="900000"

# NewRank (新榜) API key — optional, paid service for real WeChat data
# NEWRANK_API_KEY="nr-..."
